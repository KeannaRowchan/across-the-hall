{
  "name": "across-the-hall",
  "version": "0.1.0",
  "private": true,
  "description": "A department directory that makes research skills, projects and collaboration openings visible across labs.",
  "author": "KeannaRowchan",
  "license": "MIT",
  "homepage": "https://github.com/KeannaRowchan/across-the-hall",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-data.mjs",
    "typecheck": "tsc -b --force",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
